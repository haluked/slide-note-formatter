{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlideNoteFormatter",
  "version": "2.0.0",
  "identifier": "com.haluked.slidenoteformatter",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Slayt Not Formatlayıcı",
        "width": 1040,
        "height": 750,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
