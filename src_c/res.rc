#include <windows.h>

1 ICON "../assets/icon-gb.ico"
1 24 "res.manifest"

1 VERSIONINFO
FILEVERSION 2,1,2,0
PRODUCTVERSION 2,1,2,0
FILEOS 0x40004
FILETYPE 0x1
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904b0"
    {
      VALUE "CompanyName", "SlideNoteFormatter"
      VALUE "FileDescription", "Native Slide Note Formatter (Win32)"
      VALUE "FileVersion", "2.1.2.0"
      VALUE "InternalName", "SlideNoteFormatter"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "SlideNoteFormatter.exe"
      VALUE "ProductName", "Slide Note Formatter"
      VALUE "ProductVersion", "2.1.2.0"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x0409, 1200
  }
}
